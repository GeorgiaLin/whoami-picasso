{
  "name": "whoami-picasso",
  "version": "0.1.0",
  "description": "Hand-drawn randomized profile pictures with deterministic face and background color selection.",
  "license": "MIT",
  "author": {
    "name": "Georgia Lin",
    "url": "https://github.com/GeorgiaLin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgiaLin/whoami-picasso.git"
  },
  "homepage": "https://github.com/GeorgiaLin/whoami-picasso#readme",
  "bugs": {
    "url": "https://github.com/GeorgiaLin/whoami-picasso/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "react-native": "./src/react-native.js",
  "sideEffects": false,
  "files": [
    "assets",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react-native": {
      "types": "./src/react-native.d.ts",
      "default": "./src/react-native.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node ./test/avatar.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "avatar",
    "profile-picture",
    "react-native",
    "random-avatar",
    "deterministic-avatar",
    "closedreview",
    "georgialin",
    "line-art"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
